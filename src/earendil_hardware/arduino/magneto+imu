#include <Wire.h>
#include <math.h>

// =======================================================
// I2C ADRESLERİ
// =======================================================
#define MPU_ADDR_1 0x68
#define MPU_ADDR_2 0x69

#define QMC5883P_ADDR 0x2C

#define SERIAL_BAUD 115200
#define LOOP_DELAY_MS 300

// =======================================================
// GY-271 / QMC5883P AYARLARI
// =======================================================
#define MAG_SAMPLE_COUNT 10

// İlk aşamada kalibrasyon kapalı.
// Sonra kalibrasyon yapınca burayı güncelleriz.
#define MAG_X_OFFSET 0.0
#define MAG_Y_OFFSET 0.0
#define MAG_Z_OFFSET 0.0

#define MAG_X_SCALE 1.0
#define MAG_Y_SCALE 1.0
#define MAG_Z_SCALE 1.0

#define HEADING_OFFSET_DEG 0.0
#define INVERT_HEADING false

// =======================================================
// GLOBAL DURUMLAR
// =======================================================
uint8_t mpuAddr = 0;

bool mpuAvailable = false;
bool magAvailable = false;

unsigned long lastMPURetryMs = 0;
unsigned long lastMagRetryMs = 0;

#define RETRY_INTERVAL_MS 2000

// =======================================================
// I2C YARDIMCI FONKSİYONLAR
// =======================================================
bool i2cExists(uint8_t addr) {
  Wire.beginTransmission(addr);
  return Wire.endTransmission() == 0;
}

bool write8(uint8_t addr, uint8_t reg, uint8_t val) {
  Wire.beginTransmission(addr);
  Wire.write(reg);
  Wire.write(val);
  return Wire.endTransmission() == 0;
}

bool read8(uint8_t addr, uint8_t reg, uint8_t &val) {
  Wire.beginTransmission(addr);
  Wire.write(reg);

  if (Wire.endTransmission(false) != 0) {
    return false;
  }

  uint8_t received = Wire.requestFrom(addr, (uint8_t)1);

  if (received != 1) {
    return false;
  }

  if (!Wire.available()) {
    return false;
  }

  val = Wire.read();
  return true;
}

bool readBytes(uint8_t addr, uint8_t reg, uint8_t count, uint8_t *dest) {
  Wire.beginTransmission(addr);
  Wire.write(reg);

  if (Wire.endTransmission(false) != 0) {
    return false;
  }

  uint8_t received = Wire.requestFrom(addr, count);

  if (received != count) {
    return false;
  }

  for (uint8_t i = 0; i < count; i++) {
    if (!Wire.available()) {
      return false;
    }

    dest[i] = Wire.read();
  }

  return true;
}

float normalizeAngle(float angle) {
  while (angle >= 360.0) {
    angle -= 360.0;
  }

  while (angle < 0.0) {
    angle += 360.0;
  }

  return angle;
}

// =======================================================
// I2C SCANNER
// =======================================================
void scanI2C() {
  Serial.println("I2C taraniyor...");

  int count = 0;

  for (uint8_t addr = 1; addr < 127; addr++) {
    if (i2cExists(addr)) {
      Serial.print("Cihaz bulundu: 0x");

      if (addr < 16) {
        Serial.print("0");
      }

      Serial.println(addr, HEX);
      count++;
    }
  }

  if (count == 0) {
    Serial.println("Hic I2C cihazi bulunamadi.");
  }

  Serial.print("Toplam cihaz: ");
  Serial.println(count);
  Serial.println();
}

// =======================================================
// GY-91 / MPU BAŞLATMA
// =======================================================
bool initMPU() {
  if (i2cExists(MPU_ADDR_1)) {
    mpuAddr = MPU_ADDR_1;
  } 
  else if (i2cExists(MPU_ADDR_2)) {
    mpuAddr = MPU_ADDR_2;
  } 
  else {
    mpuAddr = 0;
    return false;
  }

  Serial.print("GY-91 MPU bulundu. Adres: 0x");
  Serial.println(mpuAddr, HEX);

  uint8_t whoami = 0;

  if (read8(mpuAddr, 0x75, whoami)) {
    Serial.print("MPU WHO_AM_I: 0x");
    Serial.println(whoami, HEX);
  } else {
    Serial.println("MPU WHO_AM_I okunamadi ama init deneniyor.");
  }

  // Wake up
  write8(mpuAddr, 0x6B, 0x00);
  delay(100);

  // Clock source: gyro PLL
  write8(mpuAddr, 0x6B, 0x01);
  delay(100);

  // DLPF
  write8(mpuAddr, 0x1A, 0x03);

  // Gyro ±250 dps
  write8(mpuAddr, 0x1B, 0x00);

  // Accel ±2g
  write8(mpuAddr, 0x1C, 0x00);

  // Accel DLPF
  write8(mpuAddr, 0x1D, 0x03);

  Serial.println("GY-91 MPU baslatildi.");
  return true;
}

// =======================================================
// GY-91 IMU OKUMA
// =======================================================
bool readMPU(float &ax_g, float &ay_g, float &az_g,
             float &gx_dps, float &gy_dps, float &gz_dps,
             float &temp_c) {
  if (mpuAddr == 0) {
    return false;
  }

  uint8_t b[14];

  // ACCEL_X/Y/Z, TEMP, GYRO_X/Y/Z
  if (!readBytes(mpuAddr, 0x3B, 14, b)) {
    return false;
  }

  int16_t rawAx = ((int16_t)b[0] << 8) | b[1];
  int16_t rawAy = ((int16_t)b[2] << 8) | b[3];
  int16_t rawAz = ((int16_t)b[4] << 8) | b[5];

  int16_t rawTemp = ((int16_t)b[6] << 8) | b[7];

  int16_t rawGx = ((int16_t)b[8] << 8) | b[9];
  int16_t rawGy = ((int16_t)b[10] << 8) | b[11];
  int16_t rawGz = ((int16_t)b[12] << 8) | b[13];

  // ±2g için 16384 LSB/g
  ax_g = rawAx / 16384.0;
  ay_g = rawAy / 16384.0;
  az_g = rawAz / 16384.0;

  // ±250 dps için 131 LSB/dps
  gx_dps = rawGx / 131.0;
  gy_dps = rawGy / 131.0;
  gz_dps = rawGz / 131.0;

  // MPU9250 / MPU6500 için yaklaşık sıcaklık formülü
  temp_c = rawTemp / 333.87 + 21.0;

  return true;
}

// =======================================================
// QMC5883P / 0x2C PUSULA BAŞLATMA
// =======================================================
bool initQMC5883P() {
  if (!i2cExists(QMC5883P_ADDR)) {
    return false;
  }

  Serial.println("GY-271 QMC5883P / 0x2C pusula bulundu.");

  // QMC5883P init
  write8(QMC5883P_ADDR, 0x29, 0x06);
  delay(10);

  write8(QMC5883P_ADDR, 0x0B, 0x08);
  delay(10);

  write8(QMC5883P_ADDR, 0x0A, 0xCD);
  delay(100);

  Serial.println("GY-271 pusula baslatildi.");
  return true;
}

// =======================================================
// QMC5883P HAM VERİ OKUMA
// =======================================================
bool readRawQMC5883P(int16_t &rawX, int16_t &rawY, int16_t &rawZ) {
  uint8_t b[6];

  // QMC5883P veri registerları: 0x01 - 0x06
  // X_L, X_H, Y_L, Y_H, Z_L, Z_H
  if (!readBytes(QMC5883P_ADDR, 0x01, 6, b)) {
    return false;
  }

  rawX = ((int16_t)b[1] << 8) | b[0];
  rawY = ((int16_t)b[3] << 8) | b[2];
  rawZ = ((int16_t)b[5] << 8) | b[4];

  return true;
}

// =======================================================
// QMC5883P HEADING OKUMA
// =======================================================
bool readMagHeading(float &headingDeg,
                    float &rawXAvg, float &rawYAvg, float &rawZAvg,
                    float &calX, float &calY, float &calZ) {
  long sumX = 0;
  long sumY = 0;
  long sumZ = 0;

  int validCount = 0;

  for (int i = 0; i < MAG_SAMPLE_COUNT; i++) {
    int16_t rawX, rawY, rawZ;

    if (readRawQMC5883P(rawX, rawY, rawZ)) {
      sumX += rawX;
      sumY += rawY;
      sumZ += rawZ;
      validCount++;
    }

    delay(5);
  }

  if (validCount == 0) {
    return false;
  }

  rawXAvg = sumX / (float)validCount;
  rawYAvg = sumY / (float)validCount;
  rawZAvg = sumZ / (float)validCount;

  calX = (rawXAvg - MAG_X_OFFSET) * MAG_X_SCALE;
  calY = (rawYAvg - MAG_Y_OFFSET) * MAG_Y_SCALE;
  calZ = (rawZAvg - MAG_Z_OFFSET) * MAG_Z_SCALE;

  // Sensör yatayken heading
  headingDeg = atan2(calY, calX) * 180.0 / PI;
  headingDeg = normalizeAngle(headingDeg);

#if INVERT_HEADING
  headingDeg = 360.0 - headingDeg;
  headingDeg = normalizeAngle(headingDeg);
#endif

  headingDeg += HEADING_OFFSET_DEG;
  headingDeg = normalizeAngle(headingDeg);

  return true;
}

// =======================================================
// SETUP
// =======================================================
void setup() {
  Serial.begin(SERIAL_BAUD);
  delay(1000);

  Wire.begin();          // Arduino Uno: SDA=A4, SCL=A5
  Wire.setClock(100000);

  Serial.println();
  Serial.println("Arduino Uno + GY-91 IMU + GY-271 0x2C pusula");
  Serial.println("I2C: SDA=A4, SCL=A5");
  Serial.println();

  scanI2C();

  mpuAvailable = initMPU();

  if (!mpuAvailable) {
    Serial.println("GY-91 IMU ilk denemede bulunamadi.");
  }

  magAvailable = initQMC5883P();

  if (!magAvailable) {
    Serial.println("GY-271 0x2C pusula ilk denemede bulunamadi.");
  }

  Serial.println();
  Serial.println("Okuma basliyor...");
  Serial.println("------------------------------------------------------");
}

// =======================================================
// LOOP
// =======================================================
void loop() {
  float ax, ay, az;
  float gx, gy, gz;
  float temp;

  float heading;
  float rawX, rawY, rawZ;
  float calX, calY, calZ;

  Serial.println();

  // =====================================================
  // GY-91 IMU
  // =====================================================
  if (!mpuAvailable) {
    if (millis() - lastMPURetryMs > RETRY_INTERVAL_MS) {
      lastMPURetryMs = millis();
      Serial.println("GY-91 tekrar aranıyor...");
      mpuAvailable = initMPU();
    }
  }

  if (mpuAvailable) {
    if (readMPU(ax, ay, az, gx, gy, gz, temp)) {
      Serial.println("GY-91 IMU verisi alindi:");

      Serial.print("Ivme X: ");
      Serial.print(ax, 3);
      Serial.print(" g");

      Serial.print(" | Y: ");
      Serial.print(ay, 3);
      Serial.print(" g");

      Serial.print(" | Z: ");
      Serial.print(az, 3);
      Serial.println(" g");

      Serial.print("Gyro X: ");
      Serial.print(gx, 2);
      Serial.print(" dps");

      Serial.print(" | Y: ");
      Serial.print(gy, 2);
      Serial.print(" dps");

      Serial.print(" | Z: ");
      Serial.print(gz, 2);
      Serial.println(" dps");

      Serial.print("IMU Sicaklik: ");
      Serial.print(temp, 2);
      Serial.println(" C");
    } 
    else {
      Serial.println("GY-91 IMU verisi alamadim. Tekrar init denenecek.");
      mpuAvailable = false;
      mpuAddr = 0;
    }
  } 
  else {
    Serial.println("GY-91 IMU yok veya baslatilamadi.");
  }

  Serial.println();

  // =====================================================
  // GY-271 0x2C PUSULA
  // =====================================================
  if (!magAvailable) {
    if (millis() - lastMagRetryMs > RETRY_INTERVAL_MS) {
      lastMagRetryMs = millis();
      Serial.println("GY-271 0x2C tekrar aranıyor...");
      magAvailable = initQMC5883P();
    }
  }

  if (magAvailable) {
    if (readMagHeading(heading, rawX, rawY, rawZ, calX, calY, calZ)) {
      Serial.println("GY-271 pusula verisi alindi:");

      Serial.print("Heading: ");
      Serial.print(heading, 1);
      Serial.println(" derece");

      Serial.print("RAW X: ");
      Serial.print(rawX, 0);

      Serial.print(" | RAW Y: ");
      Serial.print(rawY, 0);

      Serial.print(" | RAW Z: ");
      Serial.println(rawZ, 0);

      Serial.print("CAL X: ");
      Serial.print(calX, 1);

      Serial.print(" | CAL Y: ");
      Serial.print(calY, 1);

      Serial.print(" | CAL Z: ");
      Serial.println(calZ, 1);
    } 
    else {
      Serial.println("GY-271 pusula verisi alamadim. Tekrar init denenecek.");
      magAvailable = false;
    }
  } 
  else {
    Serial.println("GY-271 0x2C pusula yok veya baslatilamadi.");
  }

  Serial.println("------------------------------------------------------");

  delay(LOOP_DELAY_MS);
}